<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url('<%= asset_path "movies.jpg" %>');">
  <div class="container">
    <h1>Movie is <strong>art</strong>!</h1>
  </div>
</div>
<h1>Movies List</h1>
<ul>
  <% @lists.each do |list| %>
    <li><%= link_to list.name, list_path(list) %></li>
  <% end %>
</ul>

<div><%= link_to "New List", new_list_path, class:"align left btn btn-primary" %></div>
